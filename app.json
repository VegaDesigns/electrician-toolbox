{
  "expo": {
    "name": "Electrician Toolbox",
    "slug": "electrician-toolbox",
    "version": "0.9.2",
    "orientation": "portrait",
    "icon": "./assets/images/electrician-toolbox-icon.png",
    "scheme": "electriciantoolbox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brokecoderlabs.electriciantoolbox",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12161B",
        "foregroundImage": "./assets/images/electrician-toolbox-icon.png"
      },
      "package": "com.brokecoderlabs.electriciantoolbox",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/electrician-toolbox-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/electrician-toolbox-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F0E8",
          "dark": {
            "backgroundColor": "#171E1B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "412fb0c1-3331-4880-b7ee-a5c298810996"
      }
    },
    "owner": "brokecoderlabs",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/412fb0c1-3331-4880-b7ee-a5c298810996"
    }
  }
}
