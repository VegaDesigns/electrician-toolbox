{
  "expo": {
    "name": "Electrician Toolbox",
    "slug": "electrician-toolbox",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/electrician-toolbox-icon.png",
    "scheme": "electriciantoolbox",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vegadesigns.electriciantoolbox",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/images/electrician-toolbox-icon.png"
      },
      "package": "com.vegadesigns.electriciantoolbox",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/electrician-toolbox-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/electrician-toolbox-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
