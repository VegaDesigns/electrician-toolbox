{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "fieldtest": {
      "extends": "production",
      "distribution": "store",
      "channel": "fieldtest"
    }
  },
  "submit": {
    "production": {},
    "fieldtest": {}
  }
}
