{
  "name": "electrician-toolbox",
  "main": "expo-router/entry",
  "version": "0.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint app src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/utils/calc/engine.test.ts src/utils/calc/parser.test.ts src/utils/calc/measure.test.ts src/utils/calc/outputIntent.test.ts src/utils/panelColors/phase.test.ts src/utils/conduitFill/conduitFill.test.ts src/utils/boxFill/boxFill.test.ts src/utils/wireGuide/ampacity.test.ts src/utils/tradeTalk/dictionary.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "doctor": "expo-doctor",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "^1.20.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "private": true
}
